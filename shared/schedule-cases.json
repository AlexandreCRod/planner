    {
      "name": "currentEntry: early-ticked future occurrence shows DONE",
      "fn": "currentEntry",
      "items": [{ "id": 1, "title": "mondays", "startDay": "2026-10-12", "freq": "WEEKLY" }],
      "done": [{ "itemId": 1, "day": "2026-10-12" }, { "itemId": 1, "day": "2026-10-19" }],
      "today": "2026-10-15",
      "expect": { "id": 1, "day": "2026-10-19", "status": "DONE" }
