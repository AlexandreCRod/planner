        { "id": 2, "day": "2026-10-13", "status": "MISSED" },
        { "id": 1, "day": "2026-10-13", "status": "DONE" }
      ]
    },
    {
      "name": "tasksOnDay: later day shows DUE, early tick DONE, timed first, titles by code unit",
