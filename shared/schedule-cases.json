        { "itemId": 1, "day": "2026-10-01" }, { "itemId": 1, "day": "2026-10-02" }, { "itemId": 1, "day": "2026-10-03" },
        { "itemId": 1, "day": "2026-10-04" }, { "itemId": 1, "day": "2026-10-06" }, { "itemId": 1, "day": "2026-10-07" },
        { "itemId": 1, "day": "2026-10-08" }, { "itemId": 1, "day": "2026-10-09" }, { "itemId": 1, "day": "2026-10-10" },
        { "itemId": 1, "day": "2026-10-11" }, { "itemId": 1, "day": "2026-10-12" }, { "itemId": 1, "day": "2026-10-13" },
